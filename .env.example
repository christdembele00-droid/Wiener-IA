# Firebase Web/Auth
# Client identifier used by the server for Firebase Authentication.
# Do not use the reserved FIREBASE_ prefix for the Secret Manager secret.
WIENER_FIREBASE_WEB_API_KEY=

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Cloudinary (server-side only)
# Use the full URL generated by Cloudinary.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@bk4jm7px

# Local-only optional Firebase project override.
FIREBASE_PROJECT_ID=weiner-ia
